<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Kulso arnyek es ragyogas -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="38dp"
                android:startColor="#8000E676"
                android:endColor="#00001833" />
        </shape>
    </item>
    <!-- Femes 3D kulso gyuru -->
    <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:startColor="#69FFE0"
                android:centerColor="#087B79"
                android:endColor="#063D54" />
            <stroke android:width="2dp" android:color="#8000E5FF" />
        </shape>
    </item>
    <!-- Melykek 3D mag -->
    <item android:left="9dp" android:top="9dp" android:right="9dp" android:bottom="9dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="28dp"
                android:startColor="#00E676"
                android:centerColor="#008F88"
                android:endColor="#001F3F" />
            <stroke android:width="1.5dp" android:color="#4000E5FF" />
        </shape>
    </item>
    <!-- Belso vilagito gyuru -->
    <item android:left="14dp" android:top="14dp" android:right="14dp" android:bottom="14dp">
        <shape android:shape="oval">
            <solid android:color="#1A00E676" />
            <stroke android:width="1.5dp" android:color="#D8FFEF" />
        </shape>
    </item>
    <!-- Hofeher mikrofon ikon -->
    <item
        android:drawable="@android:drawable/ic_btn_speak_now"
        android:left="18dp"
        android:top="18dp"
        android:right="18dp"
        android:bottom="18dp" />
</layer-list>
